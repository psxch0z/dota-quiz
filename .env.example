# Скопируй этот файл в .env и заполни своими значениями.
# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Публичный адрес, на котором крутится сайт (для Steam OpenID callback).
# Для локальной разработки оставь как есть.
SITE_URL=http://localhost:8420
# Случайная строка для подписи cookie-сессий. Сгенерировать:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Строка подключения к Postgres (Neon и подобные обычно дают её сразу в таком виде).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
